# Copy this file to server/.env and fill in real values.
# server/.env is git-ignored - never commit real credentials.

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/learnify_db

# JWT signing secret: any random string of at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRATION_MINUTES=120

# Initial accounts (created on first start if missing). Passwords: at least 8 characters.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
APP_TEACHER_USERNAME=teacher
APP_TEACHER_PASSWORD=

# Allowed browser origins (only needed when the frontend calls the API directly, not via the Vite proxy)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Set to true to load demo students/subjects/marks into an EMPTY database
DEMO_DATA=false
